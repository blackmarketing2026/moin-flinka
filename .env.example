# Stripe (Testmodus-Keys aus dem Stripe-Dashboard: Entwickler -> API-Schluessel)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
SITE_URL=https://www.moin-flinka.de
# Admin-Zugang: Benutzername admin. Passwort nicht ins Repository schreiben.
ADMIN_PASSWORD=
# Zufaelliger Signaturschluessel mit mindestens 32 Zeichen
ADMIN_SESSION_SECRET=
# Erst verfuegbar, sobald ein Webhook-Endpoint existiert (Stripe CLI "stripe listen" oder Dashboard)
STRIPE_WEBHOOK_SECRET=whsec_...

# SMTP fuer Lead-Formular und interne Zahlungsbenachrichtigung (siehe api/_lib/mailer.js)
smtp_server=
smtp_user=
smtp_passwort=
smtp_empaenger=

# SMTP fuer Kunden-Mails zur Kennzeichen-Bestellung (Bestelleingang + Rechnung), eigenes Postfach
order_smtp_server=
order_smtp_user=
order_smtp_passwort=
